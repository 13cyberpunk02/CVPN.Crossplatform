<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Avalonia: версии держать одинаковыми -->
        <PackageVersion Include="Avalonia" Version="12.1.3" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageVersion Include="Avalonia.Android" Version="12.1.3" />
        <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />

        <PackageVersion Include="QRCoder" Version="1.8.0" />
        <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />

        <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />

        <!-- Тесты -->
        <PackageVersion Include="coverlet.collector" Version="10.0.1" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    </ItemGroup>
</Project>
