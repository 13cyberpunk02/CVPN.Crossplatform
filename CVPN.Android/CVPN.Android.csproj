<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.cyberpunk.cvpn</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Отладка - телефон arm64 и эмулятор x86_64 -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Релиз - только arm64: это все современные телефоны. x86_64 нужна лишь
    эмулятору и удвоила бы APK (ядро на каждую архитектуру - десятки МБ).
    AOT - по профилю запуска (по умолчанию в .NET Android): заранее компилируется
    то, что нужно при старте, остальное - JIT. Полный AOT раздувал APK.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <!--
    Ядро sing-box (libsingbox.so) и tun2socks (libhev-socks5-tunnel.so) лежат в
    natives/<abi>/ - их скачивает packaging/android/fetch-natives.ps1. Отдельный
    AndroidNativeLibrary не нужен: SDK сам берёт *.so из проекта, ABI - по имени папки.

    hev-socks5-tunnel.jar - Java-класс hev.htproxy.TProxyService из AAR. JNI_OnLoad
    библиотеки ищет его при любой загрузке через System.loadLibrary; без класса
    приложение падает на старте (видно в отлаживаемой сборке с CheckJNI).
    Bind=false: C#-обёртка не нужна, библиотеку мы вызываем через P/Invoke.
  -->
  <ItemGroup Condition="Exists('natives\hev-socks5-tunnel.jar')">
    <AndroidJavaLibrary Include="natives\hev-socks5-tunnel.jar" Bind="false" />
    <ProguardConfiguration Include="hev-proguard.cfg" />
  </ItemGroup>

  <Target Name="CheckNatives" BeforeTargets="Build">
    <Warning Condition="!Exists('natives\arm64-v8a\libsingbox.so')"
             Text="Нет нативных библиотек: VPN в APK работать не будет. Запустите packaging/android/fetch-natives.ps1" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CVPN\CVPN.csproj" />
  </ItemGroup>
</Project>
