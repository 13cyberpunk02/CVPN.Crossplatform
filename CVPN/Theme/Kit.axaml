<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Свои шаблоны контролов (ControlTheme). Заменяют тему Fluent целиком,
        поэтому все анимации и состояния - здесь, а не в разметке страниц.

        Кнопка, варианты по классам:
          (без класса) - обычная, с обводкой
          primary      - главное действие, лазурный градиент. На экране одно.
          ghost        - без фона и рамки, для второстепенных действий
          danger       - необратимые действия
          icon         - квадратная, под иконку (Path.icon внутри)
          small        - компактная, для строк списков
          caption      - кнопки шапки окна; caption.close краснеет при наведении
    -->

    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True">
                    <ContentPresenter.Transitions>
                        <Transitions>
                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                        </Transitions>
                    </ContentPresenter.Transitions>
                </ContentPresenter>
            </ControlTemplate>
        </Setter>

        <!-- ===== обычная ===== -->
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <!-- Нажатие - лёгкое «проседание» кнопки -->
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- ===== главная ===== -->
        <Style Selector="^.primary">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
        </Style>
        <Style Selector="^.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        </Style>
        <!-- Свечение под главной кнопкой при наведении -->
        <Style Selector="^.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 4 18 0 #552EA8F0" />
        </Style>

        <!-- ===== прозрачная ===== -->
        <Style Selector="^.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="^.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <!-- ===== опасная ===== -->
        <Style Selector="^.danger">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerLine}" />
        </Style>
        <Style Selector="^.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource Tint.Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>

        <!-- ===== размеры ===== -->
        <Style Selector="^.small">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="{StaticResource Size.Small}" />
        </Style>
        <Style Selector="^.icon">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- ===== шапка окна ===== -->
        <Style Selector="^.caption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^.caption:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="^.caption:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="^.caption.close:pointerover">
            <Setter Property="Background" Value="#FFE5484D" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
