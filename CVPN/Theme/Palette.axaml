            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#FFE5EEF5" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FFE5EEF5" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FFE5EEF5" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FFC5D4E1" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FF9FB7CB" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FF9FB7CB" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FFC5D4E1" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#FF9FB7CB" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#FF9FB7CB" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF5B7488" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FF33495C" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FF33495C" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF0A84D6" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF2196E3" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF0A6FB5" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF0A84D6" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF2196E3" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FFF5F9FC" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FFC5D4E1" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#FF33495C" />
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FFC5D4E1" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF9FB7CB" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#FF0A84D6" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        Типографика - общая для обеих тем. Санс - то, чем управляет человек;
        моно - всё машинное: адреса, порты, скорости, UUID, логи.
    -->
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, JetBrains Mono, DejaVu Sans Mono, Liberation Mono, Roboto Mono, monospace</FontFamily>

    <x:Double x:Key="Size.Caption">11</x:Double>
    <x:Double x:Key="Size.Small">12</x:Double>
    <x:Double x:Key="Size.Body">13</x:Double>
    <x:Double x:Key="Size.Heading">16</x:Double>
    <x:Double x:Key="Size.Title">22</x:Double>

    <CornerRadius x:Key="Radius">10</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <!-- Скорость анимаций: быстрые - отклик на действие, плавные - смена состояния -->
    <x:TimeSpan x:Key="Anim.Fast">0:0:0.12</x:TimeSpan>
    <x:TimeSpan x:Key="Anim.Normal">0:0:0.2</x:TimeSpan>
    <x:TimeSpan x:Key="Anim.Slow">0:0:0.45</x:TimeSpan>
</ResourceDictionary>
