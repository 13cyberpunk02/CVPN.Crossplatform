<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Палитра CVPN: тёмная и светлая темы с лазурным акцентом.
        Файл сгенерирован из двух таблиц цветов - ключи в темах совпадают
        один в один. В разметке цвета берутся только через DynamicResource:
        тема переключается на лету, StaticResource застыл бы на первой.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Clr.Bg">#FF0E1620</Color>
            <SolidColorBrush x:Key="Bg" Color="#FF0E1620" />
            <Color x:Key="Clr.Chrome">#FF0A121A</Color>
            <SolidColorBrush x:Key="Chrome" Color="#FF0A121A" />
            <Color x:Key="Clr.Surface">#FF142130</Color>
            <SolidColorBrush x:Key="Surface" Color="#FF142130" />
            <Color x:Key="Clr.SurfaceRaised">#FF1A2A3B</Color>
            <SolidColorBrush x:Key="SurfaceRaised" Color="#FF1A2A3B" />
            <Color x:Key="Clr.SurfaceHover">#FF213448</Color>
            <SolidColorBrush x:Key="SurfaceHover" Color="#FF213448" />
            <Color x:Key="Clr.Console">#FF0A1119</Color>
            <SolidColorBrush x:Key="Console" Color="#FF0A1119" />
            <Color x:Key="Clr.InputBg">#FF0F1A26</Color>
            <SolidColorBrush x:Key="InputBg" Color="#FF0F1A26" />
            <Color x:Key="Clr.Line">#FF1E2E3F</Color>
            <SolidColorBrush x:Key="Line" Color="#FF1E2E3F" />
            <Color x:Key="Clr.LineStrong">#FF2B4055</Color>
            <SolidColorBrush x:Key="LineStrong" Color="#FF2B4055" />
            <Color x:Key="Clr.LineHover">#FF3A5670</Color>
            <SolidColorBrush x:Key="LineHover" Color="#FF3A5670" />
            <Color x:Key="Clr.Text">#FFE4EEF6</Color>
            <SolidColorBrush x:Key="Text" Color="#FFE4EEF6" />
            <Color x:Key="Clr.TextSecondary">#FFA8BDCF</Color>
            <SolidColorBrush x:Key="TextSecondary" Color="#FFA8BDCF" />
            <Color x:Key="Clr.TextMuted">#FF7A93A8</Color>
            <SolidColorBrush x:Key="TextMuted" Color="#FF7A93A8" />
            <Color x:Key="Clr.TextFaint">#FF587087</Color>
            <SolidColorBrush x:Key="TextFaint" Color="#FF587087" />
            <Color x:Key="Clr.OnAccent">#FF04121C</Color>
            <SolidColorBrush x:Key="OnAccent" Color="#FF04121C" />
            <Color x:Key="Clr.Accent">#FF2EA8F0</Color>
            <SolidColorBrush x:Key="Accent" Color="#FF2EA8F0" />
            <Color x:Key="Clr.AccentHover">#FF55BAF4</Color>
            <SolidColorBrush x:Key="AccentHover" Color="#FF55BAF4" />
            <Color x:Key="Clr.AccentPress">#FF1A8FD6</Color>
            <SolidColorBrush x:Key="AccentPress" Color="#FF1A8FD6" />
            <Color x:Key="Clr.AccentSoft">#FF5FD8F2</Color>
            <SolidColorBrush x:Key="AccentSoft" Color="#FF5FD8F2" />
            <Color x:Key="Clr.Connected">#FF2DD4A7</Color>
            <SolidColorBrush x:Key="Connected" Color="#FF2DD4A7" />
            <Color x:Key="Clr.Warning">#FFF2B54A</Color>
            <SolidColorBrush x:Key="Warning" Color="#FFF2B54A" />
            <Color x:Key="Clr.Danger">#FFFF6B6B</Color>
            <SolidColorBrush x:Key="Danger" Color="#FFFF6B6B" />
            <Color x:Key="Clr.DangerLine">#FF4A2A33</Color>
            <SolidColorBrush x:Key="DangerLine" Color="#FF4A2A33" />
            <Color x:Key="Clr.Scrim">#A6050B12</Color>
            <SolidColorBrush x:Key="Scrim" Color="#A6050B12" />
            <Color x:Key="Clr.Glow">#592EA8F0</Color>
            <SolidColorBrush x:Key="Glow" Color="#592EA8F0" />
            <Color x:Key="Clr.GlowConnected">#592DD4A7</Color>
            <SolidColorBrush x:Key="GlowConnected" Color="#592DD4A7" />

            <!-- Подложки статусов -->
            <SolidColorBrush x:Key="Tint.Accent" Color="#FF2EA8F0" Opacity="0.14" />
            <SolidColorBrush x:Key="Tint.Connected" Color="#FF2DD4A7" Opacity="0.14" />
            <SolidColorBrush x:Key="Tint.Danger" Color="#FFFF6B6B" Opacity="0.14" />
            <SolidColorBrush x:Key="Tint.Warning" Color="#FFF2B54A" Opacity="0.14" />

            <!-- Отдача на графиках и в карточках: фиолетовый, чтобы не спорить с лазурным приёмом -->
            <SolidColorBrush x:Key="Upload" Color="#FFA78BFA" />
            <SolidColorBrush x:Key="Tint.Upload" Color="#FFA78BFA" Opacity="0.14" />

            <!-- Акцентный градиент: главная кнопка, логотип, дуга круга -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#FF2EA8F0" />
                <GradientStop Offset="1" Color="#FF5FD8F2" />
            </LinearGradientBrush>

            <!-- Кольцо вокруг кнопки подключения: «комета» с ярким концом, вращается всегда -->
            <ConicGradientBrush x:Key="DialSweep" Center="50%,50%">
                <GradientStop Offset="0" Color="#262EA8F0" />
                <GradientStop Offset="0.45" Color="#FF2EA8F0" />
                <GradientStop Offset="0.8" Color="#FF5FD8F2" />
                <GradientStop Offset="0.97" Color="#FFE6FAFF" />
                <GradientStop Offset="1" Color="#262EA8F0" />
            </ConicGradientBrush>
            <ConicGradientBrush x:Key="DialSweepConnected" Center="50%,50%">
                <GradientStop Offset="0" Color="#262DD4A7" />
                <GradientStop Offset="0.45" Color="#FF2DD4A7" />
                <GradientStop Offset="0.8" Color="#FF7FF0D2" />
                <GradientStop Offset="0.97" Color="#FFE6FFF7" />
                <GradientStop Offset="1" Color="#262DD4A7" />
            </ConicGradientBrush>
            <ConicGradientBrush x:Key="DialSweepFailing" Center="50%,50%">
                <GradientStop Offset="0" Color="#26FF6B6B" />
                <GradientStop Offset="0.45" Color="#FFFF6B6B" />
                <GradientStop Offset="0.8" Color="#FFFFA3A3" />
                <GradientStop Offset="0.97" Color="#FFFFE9E9" />
                <GradientStop Offset="1" Color="#26FF6B6B" />
            </ConicGradientBrush>

            <!-- Фон главной страницы: лазурная подсветка сверху и сияние за кругом подключения -->
            <LinearGradientBrush x:Key="HeroBackdrop" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF10283C" />
                <GradientStop Offset="0.75" Color="#FF0E1620" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="HeroGlow" Center="50%,46%" GradientOrigin="50%,46%" RadiusX="45%" RadiusY="45%">
                <GradientStop Offset="0" Color="#552EA8F0" />
                <GradientStop Offset="1" Color="#002EA8F0" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="HeroGlowConnected" Center="50%,46%" GradientOrigin="50%,46%" RadiusX="45%" RadiusY="45%">
                <GradientStop Offset="0" Color="#4D2DD4A7" />
                <GradientStop Offset="1" Color="#002DD4A7" />
            </RadialGradientBrush>

            <!-- Акцент Fluent - для контролов, которые мы не перерисовываем -->
            <Color x:Key="SystemAccentColor">#FF2EA8F0</Color>
            <Color x:Key="SystemAccentColorLight1">#FF55BAF4</Color>
            <Color x:Key="SystemAccentColorLight2">#FF5FD8F2</Color>
            <Color x:Key="SystemAccentColorLight3">#FF5FD8F2</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1A8FD6</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1A8FD6</Color>
            <Color x:Key="SystemAccentColorDark3">#FF1A8FD6</Color>

            <!-- Ресурсы Fluent: поля, списки, переключатели в наших цветах -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FF0F1A26" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF0F1A26" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF0F1A26" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF0F1A26" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF2B4055" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF3A5670" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF2EA8F0" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFE4EEF6" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFE4EEF6" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFE4EEF6" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF587087" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF587087" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF587087" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FF1A8FD6" />
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="#FF7A93A8" />
            <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFE4EEF6" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF0F1A26" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF0F1A26" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF0F1A26" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FF0F1A26" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FF0F1A26" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF2B4055" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF3A5670" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FF2EA8F0" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#FF2EA8F0" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFE4EEF6" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FFE4EEF6" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF7A93A8" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF1A2A3B" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FF2B4055" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#FFA8BDCF" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#FFE4EEF6" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFE4EEF6" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFE4EEF6" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FF213448" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#FF213448" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FF213448" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FF213448" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF2B4055" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FF3A5670" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FF3A5670" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF2B4055" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#FF3A5670" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#FF3A5670" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF7A93A8" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFA8BDCF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFA8BDCF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF2EA8F0" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF55BAF4" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF1A8FD6" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF2EA8F0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF55BAF4" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF04121C" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF04121C" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FF04121C" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FF1A2A3B" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF2B4055" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#FFA8BDCF" />
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FF2B4055" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF3A5670" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#FF2EA8F0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="Clr.Bg">#FFF2F6FA</Color>
            <SolidColorBrush x:Key="Bg" Color="#FFF2F6FA" />
            <Color x:Key="Clr.Chrome">#FFE8EFF5</Color>
            <SolidColorBrush x:Key="Chrome" Color="#FFE8EFF5" />
            <Color x:Key="Clr.Surface">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF" />
            <Color x:Key="Clr.SurfaceRaised">#FFF5F9FC</Color>
            <SolidColorBrush x:Key="SurfaceRaised" Color="#FFF5F9FC" />
            <Color x:Key="Clr.SurfaceHover">#FFE5EEF5</Color>
            <SolidColorBrush x:Key="SurfaceHover" Color="#FFE5EEF5" />
            <Color x:Key="Clr.Console">#FFF8FBFD</Color>
            <SolidColorBrush x:Key="Console" Color="#FFF8FBFD" />
            <Color x:Key="Clr.InputBg">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="InputBg" Color="#FFFFFFFF" />
            <Color x:Key="Clr.Line">#FFDCE6EF</Color>
            <SolidColorBrush x:Key="Line" Color="#FFDCE6EF" />
            <Color x:Key="Clr.LineStrong">#FFC5D4E1</Color>
            <SolidColorBrush x:Key="LineStrong" Color="#FFC5D4E1" />
            <Color x:Key="Clr.LineHover">#FF9FB7CB</Color>
            <SolidColorBrush x:Key="LineHover" Color="#FF9FB7CB" />
            <Color x:Key="Clr.Text">#FF0F1E2B</Color>
            <SolidColorBrush x:Key="Text" Color="#FF0F1E2B" />
            <Color x:Key="Clr.TextSecondary">#FF33495C</Color>
            <SolidColorBrush x:Key="TextSecondary" Color="#FF33495C" />
            <Color x:Key="Clr.TextMuted">#FF5B7488</Color>
            <SolidColorBrush x:Key="TextMuted" Color="#FF5B7488" />
            <Color x:Key="Clr.TextFaint">#FF8EA3B5</Color>
            <SolidColorBrush x:Key="TextFaint" Color="#FF8EA3B5" />
            <Color x:Key="Clr.OnAccent">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />
            <Color x:Key="Clr.Accent">#FF0A84D6</Color>
            <SolidColorBrush x:Key="Accent" Color="#FF0A84D6" />
            <Color x:Key="Clr.AccentHover">#FF2196E3</Color>
            <SolidColorBrush x:Key="AccentHover" Color="#FF2196E3" />
            <Color x:Key="Clr.AccentPress">#FF0A6FB5</Color>
            <SolidColorBrush x:Key="AccentPress" Color="#FF0A6FB5" />
            <Color x:Key="Clr.AccentSoft">#FF34B6EA</Color>
            <SolidColorBrush x:Key="AccentSoft" Color="#FF34B6EA" />
            <Color x:Key="Clr.Connected">#FF0E9F7B</Color>
            <SolidColorBrush x:Key="Connected" Color="#FF0E9F7B" />
            <Color x:Key="Clr.Warning">#FFB97800</Color>
            <SolidColorBrush x:Key="Warning" Color="#FFB97800" />
            <Color x:Key="Clr.Danger">#FFD63B3B</Color>
            <SolidColorBrush x:Key="Danger" Color="#FFD63B3B" />
            <Color x:Key="Clr.DangerLine">#FFF1C4C4</Color>
            <SolidColorBrush x:Key="DangerLine" Color="#FFF1C4C4" />
            <Color x:Key="Clr.Scrim">#66203040</Color>
            <SolidColorBrush x:Key="Scrim" Color="#66203040" />
            <Color x:Key="Clr.Glow">#330A84D6</Color>
            <SolidColorBrush x:Key="Glow" Color="#330A84D6" />
            <Color x:Key="Clr.GlowConnected">#330E9F7B</Color>
            <SolidColorBrush x:Key="GlowConnected" Color="#330E9F7B" />

            <!-- Подложки статусов -->
            <SolidColorBrush x:Key="Tint.Accent" Color="#FF0A84D6" Opacity="0.14" />
            <SolidColorBrush x:Key="Tint.Connected" Color="#FF0E9F7B" Opacity="0.14" />
            <SolidColorBrush x:Key="Tint.Danger" Color="#FFD63B3B" Opacity="0.14" />
            <SolidColorBrush x:Key="Tint.Warning" Color="#FFB97800" Opacity="0.14" />

            <SolidColorBrush x:Key="Upload" Color="#FF7C5CE0" />
            <SolidColorBrush x:Key="Tint.Upload" Color="#FF7C5CE0" Opacity="0.14" />

            <!-- Акцентный градиент: главная кнопка, логотип, дуга круга -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#FF0A84D6" />
                <GradientStop Offset="1" Color="#FF34B6EA" />
            </LinearGradientBrush>

            <!-- Кольцо вокруг кнопки подключения: «комета» с ярким концом, вращается всегда -->
            <ConicGradientBrush x:Key="DialSweep" Center="50%,50%">
                <GradientStop Offset="0" Color="#260A84D6" />
                <GradientStop Offset="0.45" Color="#FF0A84D6" />
                <GradientStop Offset="0.8" Color="#FF34B6EA" />
                <GradientStop Offset="0.97" Color="#FF9FE0FA" />
                <GradientStop Offset="1" Color="#260A84D6" />
            </ConicGradientBrush>
            <ConicGradientBrush x:Key="DialSweepConnected" Center="50%,50%">
                <GradientStop Offset="0" Color="#260E9F7B" />
                <GradientStop Offset="0.45" Color="#FF0E9F7B" />
                <GradientStop Offset="0.8" Color="#FF3CC9A0" />
                <GradientStop Offset="0.97" Color="#FFA8EBD6" />
                <GradientStop Offset="1" Color="#260E9F7B" />
            </ConicGradientBrush>
            <ConicGradientBrush x:Key="DialSweepFailing" Center="50%,50%">
                <GradientStop Offset="0" Color="#26D63B3B" />
                <GradientStop Offset="0.45" Color="#FFD63B3B" />
                <GradientStop Offset="0.8" Color="#FFF07272" />
                <GradientStop Offset="0.97" Color="#FFFFC2C2" />
                <GradientStop Offset="1" Color="#26D63B3B" />
            </ConicGradientBrush>

            <!-- Фон главной страницы: лазурная подсветка сверху и сияние за кругом подключения -->
            <LinearGradientBrush x:Key="HeroBackdrop" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFD6EBFA" />
                <GradientStop Offset="0.75" Color="#FFF2F6FA" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="HeroGlow" Center="50%,46%" GradientOrigin="50%,46%" RadiusX="45%" RadiusY="45%">
                <GradientStop Offset="0" Color="#5534B6EA" />
                <GradientStop Offset="1" Color="#0034B6EA" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="HeroGlowConnected" Center="50%,46%" GradientOrigin="50%,46%" RadiusX="45%" RadiusY="45%">
                <GradientStop Offset="0" Color="#4D1FB58A" />
                <GradientStop Offset="1" Color="#001FB58A" />
            </RadialGradientBrush>

            <!-- Акцент Fluent - для контролов, которые мы не перерисовываем -->
            <Color x:Key="SystemAccentColor">#FF0A84D6</Color>
            <Color x:Key="SystemAccentColorLight1">#FF2196E3</Color>
            <Color x:Key="SystemAccentColorLight2">#FF34B6EA</Color>
            <Color x:Key="SystemAccentColorLight3">#FF34B6EA</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0A6FB5</Color>
            <Color x:Key="SystemAccentColorDark2">#FF0A6FB5</Color>
            <Color x:Key="SystemAccentColorDark3">#FF0A6FB5</Color>

            <!-- Ресурсы Fluent: поля, списки, переключатели в наших цветах -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFC5D4E1" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF9FB7CB" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF0A84D6" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FF0F1E2B" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF0F1E2B" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF0F1E2B" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8EA3B5" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8EA3B5" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8EA3B5" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FF0A6FB5" />
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="#FF5B7488" />
            <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FF0F1E2B" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
