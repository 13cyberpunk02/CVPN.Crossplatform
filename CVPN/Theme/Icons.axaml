<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Иконки - контурные пути на сетке 24×24, в духе Lucide. Рисуются
        элементом Path со Stroke (см. стиль Path.icon), поэтому цвет и толщина
        линии наследуются от темы и состояния кнопки.
        Шрифтовые иконки (Segoe MDL2 в WPF-версии) есть только на Windows.
    -->

    <!-- ===== окно ===== -->
    <StreamGeometry x:Key="Icon.Minimize">M 7 12 L 17 12</StreamGeometry>
    <StreamGeometry x:Key="Icon.Maximize">M 7 7 L 17 7 L 17 17 L 7 17 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Restore">M 7 9.5 L 14.5 9.5 L 14.5 17 L 7 17 Z M 9.5 9.5 L 9.5 7 L 17 7 L 17 14.5 L 14.5 14.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Close">M 7 7 L 17 17 M 17 7 L 7 17</StreamGeometry>

    <!-- ===== тема ===== -->
    <StreamGeometry x:Key="Icon.Sun">M 12 8 A 4 4 0 1 1 11.99 8 Z M 12 2 L 12 4 M 12 20 L 12 22 M 4.93 4.93 L 6.34 6.34 M 17.66 17.66 L 19.07 19.07 M 2 12 L 4 12 M 20 12 L 22 12 M 4.93 19.07 L 6.34 17.66 M 17.66 6.34 L 19.07 4.93</StreamGeometry>
    <StreamGeometry x:Key="Icon.Moon">M 12 3 A 6 6 0 0 0 21 12 A 9 9 0 1 1 12 3 Z</StreamGeometry>

    <!-- ===== меню ===== -->
    <!-- Подключение: кнопка питания -->
    <StreamGeometry x:Key="Icon.connection">M 12 2 L 12 12 M 18.36 6.64 A 9 9 0 1 1 5.64 6.64</StreamGeometry>
    <!-- Профили: стойка серверов -->
    <StreamGeometry x:Key="Icon.profiles">M 4 3 L 20 3 L 20 10 L 4 10 Z M 4 14 L 20 14 L 20 21 L 4 21 Z M 7 6.5 L 7.01 6.5 M 7 17.5 L 7.01 17.5</StreamGeometry>
    <!-- Маршруты: развилка -->
    <StreamGeometry x:Key="Icon.routing">M 6 3 L 6 15 M 6 15 A 3 3 0 1 0 6.01 15 Z M 18 9 A 3 3 0 1 0 18.01 9 Z M 18 9 C 18 13 13 13 6 15</StreamGeometry>
    <!-- Соединения: пульс -->
    <StreamGeometry x:Key="Icon.connections">M 22 12 L 18 12 L 15 21 L 9 3 L 6 12 L 2 12</StreamGeometry>
    <!-- Логи: терминал -->
    <StreamGeometry x:Key="Icon.logs">M 4 17 L 10 11 L 4 5 M 12 19 L 20 19</StreamGeometry>
    <!-- ByeDPI: щит -->
    <StreamGeometry x:Key="Icon.byedpi">M 12 22 C 12 22 20 18 20 12 L 20 5 L 12 2 L 4 5 L 4 12 C 4 18 12 22 12 22 Z M 9 12 L 11 14 L 15 10</StreamGeometry>
    <!-- Настройки: ползунки -->
    <StreamGeometry x:Key="Icon.settings">M 4 6 L 10 6 M 14 6 L 20 6 M 4 12 L 6 12 M 10 12 L 20 12 M 4 18 L 14 18 M 18 18 L 20 18 M 12 4 L 12 8 M 8 10 L 8 14 M 16 16 L 16 20</StreamGeometry>

    <!-- ===== действия ===== -->
    <StreamGeometry x:Key="Icon.Plus">M 12 5 L 12 19 M 5 12 L 19 12</StreamGeometry>
    <StreamGeometry x:Key="Icon.Down">M 12 5 L 12 19 M 19 12 L 12 19 L 5 12</StreamGeometry>
    <StreamGeometry x:Key="Icon.Up">M 12 19 L 12 5 M 5 12 L 12 5 L 19 12</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronUp">M 6 15 L 12 9 L 18 15</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronDown">M 6 9 L 12 15 L 18 9</StreamGeometry>
    <!-- Поделиться: стрелка из коробки -->
    <StreamGeometry x:Key="Icon.Share">M 12 15 L 12 3 M 7 8 L 12 3 L 17 8 M 5 12 L 5 19 Q 5 21 7 21 L 17 21 Q 19 21 19 19 L 19 12</StreamGeometry>
    <!-- Изменить: карандаш -->
    <StreamGeometry x:Key="Icon.Edit">M 15 5 L 19 9 M 4 20 L 5 15.5 L 16.6 3.9 Q 17.6 2.9 18.6 3.9 L 20.1 5.4 Q 21.1 6.4 20.1 7.4 L 8.5 19 Z</StreamGeometry>
    <!-- Удалить: корзина -->
    <StreamGeometry x:Key="Icon.Trash">M 4 7 L 20 7 M 9 7 L 9 4 L 15 4 L 15 7 M 6 7 L 7 20 L 17 20 L 18 7 M 10 11 L 10 16 M 14 11 L 14 16</StreamGeometry>
    <!-- Галочка -->
    <StreamGeometry x:Key="Icon.Check">M 5 12.5 L 10 17 L 19 7</StreamGeometry>
    <StreamGeometry x:Key="Icon.X">M 7 7 L 17 17 M 17 7 L 7 17</StreamGeometry>
    <StreamGeometry x:Key="Icon.Rules">M 9 6 L 20 6 M 9 12 L 20 12 M 9 18 L 20 18 M 4 6 L 4.01 6 M 4 12 L 4.01 12 M 4 18 L 4.01 18</StreamGeometry>
</ResourceDictionary>
