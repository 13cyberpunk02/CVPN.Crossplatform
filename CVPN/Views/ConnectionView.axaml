<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CVPN.ViewModels"
             xmlns:loc="using:CVPN.Localization"
             xmlns:c="using:CVPN.Controls"
             xmlns:models="using:CVPN.Models"
             x:Class="CVPN.Views.ConnectionView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="UniformGrid.session">
            <Setter Property="Columns" Value="4" />
        </Style>
        <Style Selector=".narrow UniformGrid.session">
            <Setter Property="Columns" Value="2" />
        </Style>
        <!-- Выбор сервера: фиксированной ширины на десктопе, во всю строку на телефоне -->
        <Style Selector="ComboBox.server">
            <Setter Property="Width" Value="300" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector=".narrow ComboBox.server">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.metric">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Сияние за кругом: лазурное, при подключении плавно сменяется зелёным -->
        <Style Selector="Border.glow">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6" Easing="SineEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.glow.idle.on, Border.glow.live">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.glow.live.on">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel>
    <Border Background="{DynamicResource HeroBackdrop}" />
    <Border Classes="glow idle" Classes.on="{Binding IsConnected}" Background="{DynamicResource HeroGlow}" />
    <Border Classes="glow live" Classes.on="{Binding IsConnected}" Background="{DynamicResource HeroGlowConnected}" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Classes="page" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

            <!-- Сервер выбирается прямо здесь; состояние уже показано в шапке окна и кругом -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <ComboBox Classes="server" Margin="0,0,12,0"
                          ItemsSource="{Binding Profiles}" SelectedItem="{Binding ChosenServer}"
                          ToolTip.Tip="{loc:T Connection_ChooseServer}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ServerProfile">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Image Width="16" Height="11" VerticalAlignment="Center"
                                       Source="{Binding CountryCode, Converter={StaticResource Flag}}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="small" Content="{loc:T Connection_Measure}"
                            FontSize="{StaticResource Size.Caption}" Command="{Binding MeasureDelay}" />
                    <TextBlock Classes="mono" Text="{Binding Uptime}" VerticalAlignment="Center"
                               FontSize="{StaticResource Size.Caption}" />
                </StackPanel>
            </Grid>

            <c:ConnectDial Grid.Row="1" Margin="0,16" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Показатели -->
            <UniformGrid Grid.Row="2" Columns="3">
                <Border Classes="card metric" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Classes="caption" Text="{loc:T Connection_Download}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                            <TextBlock Classes="metric" Text="{Binding Download}" />
                            <TextBlock Classes="caption" Text="{Binding DownloadUnit}" VerticalAlignment="Bottom"
                                       Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="card metric" Margin="5,0">
                    <StackPanel>
                        <TextBlock Classes="caption" Text="{loc:T Connection_Upload}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                            <TextBlock Classes="metric" Text="{Binding Upload}" />
                            <TextBlock Classes="caption" Text="{Binding UploadUnit}" VerticalAlignment="Bottom"
                                       Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="card metric" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Classes="caption" Text="{loc:T Connection_Rules}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                            <TextBlock Classes="metric" Text="{Binding ActiveRuleCount}" />
                            <TextBlock Classes="caption" Text="{loc:T Common_Active}" VerticalAlignment="Bottom"
                                       Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Итоги сессии остаются после отключения: их для того и собирали -->
            <Border Grid.Row="3" Classes="card metric" Margin="0,10,0,0" IsVisible="{Binding Session.HasData}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="label" Text="{loc:T Connection_Session}" />
                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Session.Server}" />
                    </Grid>
                    <UniformGrid Classes="session" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="mono" Foreground="{DynamicResource Text}" Text="{Binding Session.DurationLabel}" />
                            <TextBlock Classes="caption" Text="{loc:T Connection_Duration}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="mono" Foreground="{DynamicResource Text}" Text="{Binding Session.DownloadLabel}" />
                            <TextBlock Classes="caption" Text="{loc:T Connection_Received}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="mono" Foreground="{DynamicResource Text}" Text="{Binding Session.UploadLabel}" />
                            <TextBlock Classes="caption" Text="{loc:T Connection_Sent}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="mono" Foreground="{DynamicResource Text}" Text="{Binding Session.PeakLabel}" />
                            <TextBlock Classes="caption" Text="{loc:T Connection_Peak}" Margin="0,3,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="4" Classes="status" Text="{Binding Status}" Margin="0,10,0,0" />

            <!-- Действия -->
            <WrapPanel Grid.Row="5" Margin="0,10,0,0">
                <Button Classes="small" Content="{loc:T Connection_CheckConfig}" Command="{Binding CheckConfig}" Margin="0,0,6,0" />
                <Button Classes="small" Content="{loc:T Connection_OpenConfig}" Command="{Binding OpenConfig}"
                        IsVisible="{Binding Platform.Launcher.CanOpenFiles}" />
            </WrapPanel>
        </Grid>
    </ScrollViewer>
    </Panel>
</UserControl>
