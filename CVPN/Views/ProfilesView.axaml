<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CVPN.ViewModels"
             xmlns:models="using:CVPN.Models"
             xmlns:loc="using:CVPN.Localization"
             x:Class="CVPN.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel"
             x:Name="Root">

    <Grid Classes="page" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="{loc:T Nav_Profiles}" />
            <TextBlock Classes="secondary" Text="{loc:T Profiles_Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Classes="status" Text="{Binding Status}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Действия: в ряд на десктопе, переносятся на телефоне -->
        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
            <Button Classes="primary" Command="{Binding Create}" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
                    <TextBlock Text="{loc:T Profiles_Create}" />
                </StackPanel>
            </Button>
            <Button Content="{loc:T Profiles_ImportFile}" Command="{Binding ImportFile}" Margin="0,0,8,8" />
            <Button Classes="ghost" Content="{loc:T Profiles_CheckAll}" Command="{Binding PingAll}" Margin="0,0,8,8" />
            <Button Classes="ghost" Content="{loc:T Profiles_ExportAll}" Command="{Binding ExportAll}" Margin="0,0,8,8" />
        </WrapPanel>

        <!-- Импорт по ссылке: самый частый способ завести профиль, поэтому он вверху -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <TextBox Text="{Binding LinkText}" PlaceholderText="vless://…  ·  anytls://…  ·  naive+https://…" />
            <Button Grid.Column="1" Content="{loc:T Profiles_ParseLink}" Command="{Binding ImportLink}"
                    Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBox Text="{Binding Settings.SubscriptionUrl}" PlaceholderText="{loc:T Profiles_SubscriptionHint}" />
            <Button Grid.Column="1" Content="{loc:T Profiles_UpdateSubscription}"
                    Command="{Binding UpdateSubscription}" Margin="8,0,0,0" />
        </Grid>

        <ListBox Grid.Row="4" Classes="plain" Margin="0,18,0,0" ItemsSource="{Binding Profiles}">
            <ListBox.Styles>
                <!-- На широком экране действия справа в той же строке, на телефоне - второй строкой -->
                <Style Selector="StackPanel.actions">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="2" />
                    <Setter Property="Margin" Value="10,0,0,0" />
                </Style>
                <Style Selector=".narrow StackPanel.actions">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ServerProfile">
                    <Border Classes="item" Classes.active="{Binding IsActive}">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <DockPanel LastChildFill="False">
                                    <Image DockPanel.Dock="Left" Width="18" Height="12" VerticalAlignment="Center" Margin="0,0,9,0"
                                           Source="{Binding CountryCode, Converter={StaticResource Flag}}" />
                                    <TextBlock DockPanel.Dock="Left" Classes="heading" Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Left" Classes="tag" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}" Text="{Binding ProtocolLabel}" />
                                    </Border>
                                </DockPanel>
                                <WrapPanel Margin="0,5,0,0">
                                    <TextBlock Classes="mono" FontSize="{StaticResource Size.Small}"
                                               Text="{Binding Endpoint}" Margin="0,0,10,0" />
                                    <TextBlock Classes="caption" Foreground="{DynamicResource TextFaint}"
                                               Text="{loc:T Profiles_FromSubscription}"
                                               IsVisible="{Binding Subscription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </WrapPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Classes="latency" Text="{Binding LatencyLabel}" IsVisible="{Binding HasLatency}"
                                       VerticalAlignment="Center" Margin="14,0,4,0"
                                       Classes.good="{Binding LatencyGrade, Converter={StaticResource Eq}, ConverterParameter=good}"
                                       Classes.fair="{Binding LatencyGrade, Converter={StaticResource Eq}, ConverterParameter=fair}"
                                       Classes.poor="{Binding LatencyGrade, Converter={StaticResource Eq}, ConverterParameter=poor}"
                                       Classes.dead="{Binding LatencyGrade, Converter={StaticResource Eq}, ConverterParameter=dead}" />

                            <!-- Внутри шаблона контекст - профиль, команды страницы берём у Root -->
                            <StackPanel Classes="actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Classes="ghost icon" ToolTip.Tip="{loc:T Profiles_Share}"
                                        Command="{Binding #Root.((vm:ProfilesViewModel)DataContext).ExportProfile}"
                                        CommandParameter="{Binding}">
                                    <Path Classes="icon" Data="{StaticResource Icon.Share}" />
                                </Button>
                                <Button Classes="ghost icon" ToolTip.Tip="{loc:T Common_Edit}"
                                        Command="{Binding #Root.((vm:ProfilesViewModel)DataContext).EditProfileCommand}"
                                        CommandParameter="{Binding}">
                                    <Path Classes="icon" Data="{StaticResource Icon.Edit}" />
                                </Button>
                                <Button Classes="ghost icon remove" ToolTip.Tip="{loc:T Common_Delete}"
                                        Command="{Binding #Root.((vm:ProfilesViewModel)DataContext).RemoveProfile}"
                                        CommandParameter="{Binding}">
                                    <Path Classes="icon" Data="{StaticResource Icon.Trash}" />
                                </Button>
                                <!-- Активному профилю выбирать нечего: вместо кнопки - отметка -->
                                <Panel Width="96" Margin="8,0,0,0">
                                    <Button Classes="small" Content="{loc:T Common_Select}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            IsVisible="{Binding !IsActive}"
                                            Command="{Binding #Root.((vm:ProfilesViewModel)DataContext).SelectProfile}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" IsVisible="{Binding IsActive}">
                                        <Path Classes="icon" Data="{StaticResource Icon.Check}" Width="12" Height="12"
                                              Stroke="{DynamicResource Accent}" StrokeThickness="2.2" />
                                        <TextBlock Classes="accent" FontSize="{StaticResource Size.Small}" FontWeight="SemiBold"
                                                   Text="{loc:T Profiles_Active}" />
                                    </StackPanel>
                                </Panel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
