<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CVPN.ViewModels"
             xmlns:loc="using:CVPN.Localization"
             x:Class="CVPN.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!--
        Настройки разбиты на группы с заголовками: подключение, права на TUN,
        запуск, внешний вид, обновления, ядро. Разделы, которых на платформе нет
        (служба, задача планировщика, трей, kill switch на Android), скрыты
        по флагам Show* из SettingsViewModel.
    -->
    <UserControl.Styles>
        <!-- Строка «название и пояснение слева, управление справа» -->
        <Style Selector="Grid.row > StackPanel">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.row > ToggleSwitch, Grid.row > ComboBox, Grid.row > TextBox">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.row TextBlock.caption">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Плашка обновления: лазурная полоса слева вместо предупреждающей -->
        <Style Selector="Border.card.note.update">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource Tint.Accent}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="page" Spacing="8">
            <StackPanel Margin="0,0,0,4">
                <TextBlock Classes="title" Text="{loc:T Nav_Settings}" />
                <TextBlock Classes="secondary" Text="{loc:T Settings_Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Classes="status" Text="{Binding Status}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- ===================== Подключение ===================== -->
            <TextBlock Classes="section" Text="{loc:T Settings_SectionConnection}" Margin="2,4,0,0" />
            <Border Classes="card">
                <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_Tun}" />
                            <TextBlock Classes="caption" Text="{loc:T Settings_TunHint}" />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.TunEnabled}" />
                    </Grid>

                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_MixedPort}" />
                            <TextBlock Classes="caption" Text="{loc:T Settings_MixedPortHint}" />
                        </StackPanel>
                        <TextBox Width="96" Text="{Binding Settings.MixedPort}" />
                    </Grid>

                    <StackPanel IsVisible="{Binding ShowTunAdvanced}">
                        <Border Classes="divider" />
                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_StrictRoute}" />
                                <TextBlock Classes="caption" Text="{loc:T Settings_StrictRouteHint}" />
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding Settings.StrictRoute}" />
                        </Grid>

                        <Border Classes="divider" />
                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_TunIpv6}" />
                                <TextBlock Classes="caption" Text="{loc:T Settings_TunIpv6Hint}" />
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding Settings.TunIpv6}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowKillSwitch}">
                        <Border Classes="divider" />
                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_KillSwitch}" />
                                <TextBlock Classes="caption" Text="{loc:T Settings_KillSwitchHint}" />
                                <TextBlock Classes="caption" Text="{loc:T Settings_KillSwitchWarning}" />
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding Settings.KillSwitch}" />
                        </Grid>
                        <Button Classes="small" Content="{loc:T Settings_RestoreNetwork}"
                                ToolTip.Tip="{loc:T Settings_RestoreNetworkHint}"
                                Command="{Binding RestoreNetwork}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>

                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_AutoSelect}" />
                            <TextBlock Classes="caption" Text="{loc:T Settings_AutoSelectHint}" />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.AutoSelectFastest}" />
                    </Grid>

                    <Border Classes="divider" />
                    <TextBlock Classes="field" Text="{loc:T Settings_Dns}" />
                    <TextBox Classes="code" Text="{Binding Settings.RemoteDns}" Margin="0,8,0,0" />
                    <TextBlock Classes="caption" Text="{loc:T Settings_DnsHint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===================== Служба и задача планировщика ===================== -->
            <TextBlock Classes="section" Text="{loc:T Settings_SectionPrivileged}" IsVisible="{Binding ShowPrivileged}" />
            <Border Classes="card" IsVisible="{Binding ShowPrivileged}">
                <StackPanel>
                    <StackPanel IsVisible="{Binding ShowService}">
                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_Service}" />
                                <TextBlock Classes="caption" Text="{loc:T Settings_ServiceHint}" />
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding Settings.UseService}" />
                        </Grid>
                        <!-- Состояние и одно действие, которое сейчас имеет смысл: установка или удаление -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Classes="dot" Classes.connected="{Binding ServiceInstalled}" />
                                <TextBlock Classes="caption" Text="{Binding ServiceStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary small" Content="{loc:T Settings_InstallService}"
                                        Command="{Binding InstallService}" IsVisible="{Binding CanInstallService}" />
                                <Button Classes="danger small" Content="{loc:T Settings_UninstallService}"
                                        Command="{Binding UninstallService}" IsVisible="{Binding ServiceInstalled}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowElevatedTask}">
                        <Border Classes="divider" IsVisible="{Binding ShowService}" />
                        <TextBlock Text="{loc:T Settings_Task}" />
                        <TextBlock Classes="caption" Text="{loc:T Settings_TaskHint}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <!-- Рабочая задача уже есть - создавать нечего; устаревшую предлагаем пересоздать -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Classes="dot" Classes.connected="{Binding TaskExists}" />
                                <TextBlock Classes="caption" Text="{Binding TaskStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="small" Content="{Binding InstallTaskLabel}" Command="{Binding InstallTask}"
                                        IsVisible="{Binding CanInstallTask}" />
                                <Button Classes="danger small" Content="{loc:T Settings_DeleteTask}"
                                        Command="{Binding UninstallTask}" IsVisible="{Binding TaskExists}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Запуск ===================== -->
            <TextBlock Classes="section" Text="{loc:T Settings_SectionStartup}" />
            <Border Classes="card">
                <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_AutoConnect}" />
                            <TextBlock Classes="caption" Text="{loc:T Settings_AutoConnectHint}" />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.AutoConnect}" />
                    </Grid>

                    <StackPanel IsVisible="{Binding ShowAutoStart}">
                        <Border Classes="divider" />
                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_AutoStart}" />
                                <TextBlock Classes="caption" Text="{loc:T Settings_AutoStartHint}" />
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding Settings.AutoStart}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowCloseToTray}">
                        <Border Classes="divider" />
                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings_CloseToTray}" />
                                <TextBlock Classes="caption" Text="{loc:T Settings_CloseToTrayHint}" />
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding Settings.CloseToTray}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Внешний вид ===================== -->
            <TextBlock Classes="section" Text="{loc:T Settings_SectionAppearance}" />
            <Border Classes="card">
                <StackPanel>
                    <!-- Тема применяется сразу, без перезапуска -->
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_Theme}" />
                        </StackPanel>
                        <ComboBox Width="190" ItemsSource="{Binding Themes}"
                                  SelectedValue="{Binding Settings.Theme}" SelectedValueBinding="{Binding Code}"
                                  DisplayMemberBinding="{Binding Name}" />
                    </Grid>

                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_Language}" />
                            <TextBlock Classes="caption" Text="{loc:T Settings_LanguageHint}" />
                        </StackPanel>
                        <ComboBox Width="190" ItemsSource="{Binding Languages}"
                                  SelectedValue="{Binding Settings.Language}" SelectedValueBinding="{Binding Code}"
                                  DisplayMemberBinding="{Binding Name}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== Обновления ===================== -->
            <TextBlock Classes="section" Text="{loc:T Settings_SectionUpdates}" />
            <Border Classes="card">
                <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_CheckUpdatesTitle}" />
                            <TextBlock Classes="caption" Text="{Binding UpdateLabel}" Classes.accent="{Binding HasUpdate}" />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.CheckUpdates}" />
                    </Grid>
                    <!-- Найдено обновление: поставить прямо отсюда или хотя бы прочитать, что нового -->
                    <Border Classes="card note update" Margin="0,12,0,0" Padding="14,12" IsVisible="{Binding HasUpdate}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Path Classes="icon" Data="{StaticResource Icon.Down}" Stroke="{DynamicResource Accent}" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding UpdateTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:T Update_SelfHint}"
                                       IsVisible="{Binding CanSelfUpdate}" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:T Update_ManualHint}"
                                       IsVisible="{Binding !CanSelfUpdate}" />

                            <!-- Загрузка: полоса и сколько скачано -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsUpdating}">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" Height="6" MinHeight="6"
                                             CornerRadius="3" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" />
                                <TextBlock Classes="caption" FontFamily="{StaticResource Font.Mono}" Text="{Binding UpdateProgressLabel}" />
                            </StackPanel>

                            <WrapPanel>
                                <Button Classes="primary small" Margin="0,0,8,0" Command="{Binding InstallUpdate}"
                                        IsVisible="{Binding CanSelfUpdate}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Data="{StaticResource Icon.Down}" />
                                        <TextBlock Text="{loc:T Settings_UpdateNow}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="small" Margin="0,0,8,0" Content="{loc:T Common_Cancel}" Command="{Binding CancelUpdate}"
                                        IsVisible="{Binding IsUpdating}" />
                                <Button Classes="small" Content="{loc:T Settings_WhatsNew}" Command="{Binding OpenRelease}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Classes="small" Content="{loc:T Settings_CheckNow}" Command="{Binding CheckUpdate}" />
                    </WrapPanel>

                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_AutoSubscription}" />
                            <TextBlock Classes="caption" Text="{loc:T Settings_AutoSubscriptionHint}" />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.AutoUpdateSubscription}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== Ядро ===================== -->
            <TextBlock Classes="section" Text="{loc:T Settings_SectionCore}" />
            <Border Classes="card">
                <StackPanel>
                    <StackPanel IsVisible="{Binding ShowCorePicker}">
                        <TextBlock Classes="field" Text="{loc:T Settings_CorePath}" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBox Classes="code" Text="{Binding Settings.CorePath}" />
                            <Button Grid.Column="1" Content="{loc:T Common_Browse}" Command="{Binding BrowseCore}"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <Border Classes="divider" />
                    </StackPanel>

                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings_VerboseLog}" />
                            <TextBlock Classes="caption" Text="{loc:T Settings_VerboseLogHint}" />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.VerboseLog}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
