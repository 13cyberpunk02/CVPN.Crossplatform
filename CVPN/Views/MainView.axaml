<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CVPN.ViewModels"
             xmlns:views="using:CVPN.Views"
             xmlns:loc="using:CVPN.Localization"
             x:Class="CVPN.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource Bg}"
             Foreground="{StaticResource Text}"
             FontSize="{StaticResource Size.Body}">

    <!--
        Оболочка. Широкий экран - меню слева, как в WPF-клиенте. Узкий (телефон,
        маленькое окно) - меню внизу. Переключает класс narrow в code-behind,
        он же уменьшает поля страниц (см. .narrow .page в Controls.axaml).
    -->

    <UserControl.DataTemplates>
        <!-- Страница выбирается по типу вьюмодели, как DataTemplate в WPF -->
        <DataTemplate DataType="vm:MainViewModel">
            <views:ConnectionView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfilesViewModel">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="vm:RoutingViewModel">
            <views:RoutingView />
        </DataTemplate>
        <DataTemplate DataType="vm:ConnectionsViewModel">
            <views:ConnectionsView />
        </DataTemplate>
        <DataTemplate DataType="vm:LogsViewModel">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ByeDpiViewModel">
            <views:ByeDpiView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="TextBlock#ModeTitle">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock#ModeTitle.active">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto">

            <!-- ===== боковое меню ===== -->
            <Border x:Name="Sidebar" Grid.Column="0" Grid.Row="0" Width="186"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="18,16,0,6">
                        <Rectangle Width="14" Height="14" Fill="{StaticResource Accent}" RadiusX="4" RadiusY="4" />
                        <TextBlock Text="CVPN" FontSize="{StaticResource Size.Small}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ListBox Grid.Row="1" Classes="nav" Margin="0,8,0,0"
                             ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Режим: что перехватывает трафик в этой сессии -->
                    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{loc:T Common_Mode}" />
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,5,0,0">
                                <Ellipse Classes="dot" Classes.connected="{Binding ModeActive}" />
                                <TextBlock x:Name="ModeTitle" Text="{Binding ModeTitle}"
                                           Classes.active="{Binding ModeActive}" />
                            </StackPanel>
                            <TextBlock Classes="mono" FontSize="{StaticResource Size.Caption}"
                                       Text="{Binding ModeDetail}" Margin="13,2,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption warning" Text="{Binding ModePendingHint}" Margin="13,5,0,0"
                                       TextWrapping="Wrap" IsVisible="{Binding ModePending}" />
                            <TextBlock Classes="label" Text="{Binding SingBoxVersion}" Margin="0,10,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== страница ===== -->
            <ContentControl Grid.Column="1" Grid.Row="0" Content="{Binding SelectedNav.Page}" />

            <!-- ===== нижнее меню (узкий экран) ===== -->
            <Border x:Name="BottomBar" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" IsVisible="False"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ListBox Classes="nav bottomnav" Margin="4,4"
                             ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Слой диалогов: редактор профиля, экспорт, вопросы -->
        <Panel x:Name="OverlayLayer" IsVisible="False" />
    </Panel>
</UserControl>
