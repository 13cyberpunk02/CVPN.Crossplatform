<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CVPN.ViewModels"
             xmlns:views="using:CVPN.Views"
             xmlns:loc="using:CVPN.Localization"
             x:Class="CVPN.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource Bg}"
             Foreground="{DynamicResource Text}"
             FontSize="{StaticResource Size.Body}">

    <!--
        Оболочка. Широкий экран - меню слева, как в WPF-клиенте. Узкий (телефон,
        маленькое окно) - меню внизу. Переключает класс narrow в code-behind,
        он же уменьшает поля страниц (см. .narrow .page в Controls.axaml).
    -->

    <UserControl.DataTemplates>
        <!-- Страница выбирается по типу вьюмодели, как DataTemplate в WPF -->
        <DataTemplate DataType="vm:MainViewModel">
            <views:ConnectionView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfilesViewModel">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="vm:RoutingViewModel">
            <views:RoutingView />
        </DataTemplate>
        <DataTemplate DataType="vm:ConnectionsViewModel">
            <views:ConnectionsView />
        </DataTemplate>
        <DataTemplate DataType="vm:LogsViewModel">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ByeDpiViewModel">
            <views:ByeDpiView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="TextBlock#ModeTitle">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock#ModeTitle.active">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto">

            <!-- ===== боковое меню ===== -->
            <Border x:Name="Sidebar" Grid.Column="0" Grid.Row="0" Width="200"
                    Background="{DynamicResource Chrome}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Логотип - в шапке окна; на телефоне шапки нет, и он там не нужен -->
                    <!-- Пункты лежат в утопленном лотке; клавиши и плашка - см. Controls.axaml -->
                    <Border Grid.Row="0" Classes="tray" Margin="10,12,10,0">
                        <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItem">
                                    <StackPanel Orientation="Horizontal" Spacing="11" Margin="7,0,0,0"
                                                VerticalAlignment="Center">
                                        <Border Classes="key">
                                            <Path Classes="icon" Data="{Binding Key, Converter={StaticResource Icon}}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Режим: что перехватывает трафик в этой сессии -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{loc:T Common_Mode}" />
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,5,0,0">
                                <Ellipse Classes="dot" Classes.connected="{Binding ModeActive}" />
                                <TextBlock x:Name="ModeTitle" Text="{Binding ModeTitle}"
                                           Classes.active="{Binding ModeActive}" />
                            </StackPanel>
                            <TextBlock Classes="mono" FontSize="{StaticResource Size.Caption}"
                                       Text="{Binding ModeDetail}" Margin="13,2,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption warning" Text="{Binding ModePendingHint}" Margin="13,5,0,0"
                                       TextWrapping="Wrap" IsVisible="{Binding ModePending}" />
                            <!-- Без ядра подключиться нельзя - об этом сообщаем цветом, а не серым шрифтом -->
                            <TextBlock Classes="label" Classes.warning="{Binding CoreProblem}"
                                       Text="{Binding SingBoxVersion}" Margin="0,10,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== страница ===== -->
            <!-- Смена страницы - плавное проявление -->
            <TransitioningContentControl Grid.Column="1" Grid.Row="0" Content="{Binding SelectedNav.Page}">
                <TransitioningContentControl.PageTransition>
                    <CompositePageTransition>
                        <CrossFade Duration="0:0:0.18" />
                    </CompositePageTransition>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <!-- ===== нижнее меню (узкий экран) ===== -->
            <Border x:Name="BottomBar" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" IsVisible="False"
                    Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Border Classes="tray" Margin="6" Padding="0,4">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ListBox Classes="nav bottomnav"
                                 ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItem">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="4,0">
                                        <Border Classes="key" HorizontalAlignment="Center">
                                            <Path Classes="icon" Data="{Binding Key, Converter={StaticResource Icon}}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>

        <!-- Слой диалогов: редактор профиля, экспорт, вопросы -->
        <Panel x:Name="OverlayLayer" IsVisible="False" />
    </Panel>
</UserControl>
