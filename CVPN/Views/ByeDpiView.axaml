<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CVPN.ViewModels"
             xmlns:loc="using:CVPN.Localization"
             x:Class="CVPN.Views.ByeDpiView"
             x:DataType="vm:ByeDpiViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="page" Spacing="8">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Classes="title" Text="{loc:T Nav_ByeDpi}" />
                <TextBlock Classes="secondary" Text="{loc:T ByeDpi_Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Classes="status" Text="{Binding Status}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Включение и запуск - главное на странице, поэтому наверху -->
            <Border Classes="card">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{loc:T ByeDpi_Enable}" />
                            <TextBlock Classes="caption" Text="{loc:T ByeDpi_EnableHint}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ByeDpiEnabled}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Classes="divider" />

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="0,0,12,8">
                            <Ellipse Classes="dot" Classes.connected="{Binding IsRunning}" />
                            <TextBlock Text="{Binding State}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Classes="small" Content="{loc:T ByeDpi_AddYoutube}" ToolTip.Tip="{loc:T ByeDpi_AddYoutubeHint}"
                                    Command="{Binding AddYoutubeRule}" Margin="0,0,8,8" />
                            <Button Classes="primary small" Content="{Binding RunLabel}" Command="{Binding ToggleRun}"
                                    MinWidth="110" HorizontalContentAlignment="Center" Margin="0,0,0,8" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="section" Text="{loc:T ByeDpi_SectionParams}" />
            <Border Classes="card">
                <StackPanel>
                    <!-- Путь - только на Windows: на Linux и Android ciadpi вшит в приложение -->
                    <StackPanel IsVisible="{Binding ShowPath}">
                        <TextBlock Classes="field" Text="{loc:T ByeDpi_Path}" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBox Text="{Binding Settings.ByeDpiPath}" />
                            <Button Grid.Column="1" Content="{loc:T Common_Browse}" Command="{Binding Browse}"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Classes="caption" Text="{loc:T ByeDpi_PathHint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Border Classes="divider" />
                    </StackPanel>

                    <TextBlock Classes="field" Text="{loc:T ByeDpi_Args}" />
                    <TextBox Text="{Binding Settings.ByeDpiArgs}" Margin="0,8,0,0" />
                    <TextBlock Classes="caption" Text="{loc:T ByeDpi_ArgsHint}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <!-- Итоговая строка запуска - как в терминале -->
                    <Border Background="{DynamicResource Bg}" CornerRadius="{StaticResource Radius}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Padding="12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{loc:T ByeDpi_WillRun}" />
                            <SelectableTextBlock Classes="mono" FontSize="{StaticResource Size.Small}"
                                                 Text="{Binding CommandPreview}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="caption warning" Text="{Binding IgnoredNote}" Margin="0,8,0,0"
                               TextWrapping="Wrap" IsVisible="{Binding HasIgnored}" />

                    <Border Classes="divider" />

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{loc:T ByeDpi_Port}" />
                            <TextBlock Classes="caption" Text="{loc:T ByeDpi_PortHint}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Classes="caption danger" Text="{Binding PortWarning}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" IsVisible="{Binding HasPortWarning}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="96" Text="{Binding Settings.ByeDpiPort}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel IsVisible="{Binding ShowBypassTun}">
                        <Border Classes="divider" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:T ByeDpi_BypassTun}" />
                                <TextBlock Classes="caption" Text="{loc:T ByeDpi_BypassTunHint}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ByeDpiBypassTun}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{loc:T ByeDpi_BlockQuic}" />
                            <TextBlock Classes="caption" Text="{loc:T ByeDpi_BlockQuicHint}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ByeDpiBlockQuic}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Примечание про TUN: заметная полоса слева, но обычный цвет текста - его надо прочитать, а не испугаться -->
            <Border Classes="card note" IsVisible="{Binding ShowTunNote}">
                <StackPanel>
                    <TextBlock Classes="field warning" Text="{loc:T ByeDpi_TunTitle}" />
                    <TextBlock Classes="caption" Text="{loc:T ByeDpi_TunNote}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
