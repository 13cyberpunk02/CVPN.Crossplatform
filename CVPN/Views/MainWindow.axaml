<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CVPN.ViewModels"
        xmlns:views="using:CVPN.Views"
        x:Class="CVPN.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="980" Height="660" MinWidth="380" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Icon="/Assets/cvpn.ico"
        Title="CVPN">
    <!-- Системная рамка окна: своя (WindowChrome в WPF) на Linux ведёт себя по-разному в разных DE -->
    <views:MainView x:Name="Main" />
</Window>
