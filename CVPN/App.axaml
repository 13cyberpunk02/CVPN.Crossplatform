<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:CVPN.Converters"
             x:Class="CVPN.App"
             RequestedThemeVariant="Dark">
    <!-- Тема одна - тёмная, как в WPF-клиенте -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CVPN/Theme/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EqualsConverter x:Key="Eq" />
            <conv:FlagConverter x:Key="Flag" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://CVPN/Theme/Controls.axaml" />
    </Application.Styles>
</Application>
