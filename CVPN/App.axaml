<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:CVPN.Converters"
             x:Class="CVPN.App"
             RequestedThemeVariant="Default">
    <!-- Тема задаётся настройкой (App.ApplyTheme): системная, тёмная или светлая -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CVPN.UI/Theme/Palette.axaml" />
                <ResourceInclude Source="avares://CVPN.UI/Theme/Icons.axaml" />
                <ResourceInclude Source="avares://CVPN.UI/Theme/Kit.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EqualsConverter x:Key="Eq" />
            <conv:FlagConverter x:Key="Flag" />
            <conv:IconConverter x:Key="Icon" />
            <conv:StarConverter x:Key="Star" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://CVPN.UI/Theme/Controls.axaml" />
    </Application.Styles>
</Application>
