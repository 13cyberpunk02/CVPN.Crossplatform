<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CVPN.ViewModels"
             x:Class="CVPN.Controls.ConnectDial"
             x:DataType="vm:MainViewModel"
             Width="288" Height="288">

    <!--
        Круг подключения. Обод показывает состояние, центр им управляет.
        Контекст - MainViewModel: в WPF у контрола был десяток свойств-зеркал,
        здесь он читает оболочку напрямую.
    -->
    <UserControl.Styles>
        <!-- Дуга состояния: серая - отключено, акцент с бегущим сегментом - подключение,
             зелёная - подключено, красная - ошибка -->
        <!-- Длина и цвет дуги меняются плавно: «отключено» стягивается в «подключено» -->
        <Style Selector="Arc#StateArc">
            <Setter Property="Stroke" Value="{DynamicResource TextFaint}" />
            <Setter Property="SweepAngle" Value="300" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="SweepAngle" Duration="0:0:0.6" Easing="CubicEaseInOut" />
                    <BrushTransition Property="Stroke" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Arc#StateArc.connected">
            <Setter Property="Stroke" Value="{DynamicResource Connected}" />
            <Setter Property="SweepAngle" Value="360" />
        </Style>
        <Style Selector="Arc#StateArc.failing">
            <Setter Property="Stroke" Value="{DynamicResource Danger}" />
            <Setter Property="SweepAngle" Value="360" />
        </Style>
        <Style Selector="Arc#StateArc.connecting">
            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
            <Setter Property="SweepAngle" Value="70" />
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Свечение вокруг дуги: «дышит», пока туннель работает -->
        <Style Selector="Ellipse#Halo">
            <Setter Property="Stroke" Value="{DynamicResource Glow}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse#Halo.connecting">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Ellipse#Halo.connected">
            <Setter Property="Stroke" Value="{DynamicResource GlowConnected}" />
            <Style.Animations>
                <Animation Duration="0:0:2.4" IterationCount="Infinite" PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Ядро круга - объёмная кнопка: выпуклая заливка, скос по краю, тень под ней
             и внутренняя тень снизу. При наведении чуть приближается и светлеет -->
        <Style Selector="Button#Core">
            <Setter Property="Background" Value="{DynamicResource DialFace}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialRim}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="92" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button#Core:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialFaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialRim}" />
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="Button#Core:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button#Core /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource DialShadow}" />
        </Style>

        <Style Selector="TextBlock#Metric.connected">
            <Setter Property="Foreground" Value="{DynamicResource Connected}" />
        </Style>
        <Style Selector="TextBlock#Metric.failing">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>

        <Style Selector="TextBlock#Action">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBlock#Action.connected">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <!-- ===== градиентное кольцо ===== -->
        <Style Selector="Panel#Sweep Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource DialSweep}" />
        </Style>
        <Style Selector="Panel#Sweep.connected Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource DialSweepConnected}" />
        </Style>
        <Style Selector="Panel#Sweep.failing Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource DialSweepFailing}" />
        </Style>

        <!-- Неспешное вращение в покое и после подключения -->
        <Style Selector="Panel#Sweep:not(.connecting)">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Подключение: быстрее - видно, что идёт работа -->
        <Style Selector="Panel#Sweep.connecting">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Свечение кольца дышит -->
        <Style Selector="Ellipse#SweepGlow">
            <Style.Animations>
                <Animation Duration="0:0:2.8" IterationCount="Infinite" PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ===== обводка кнопки: разгорается и гаснет целиком ===== -->
        <Style Selector="Panel#Pulse Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Panel#Pulse.connected Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource Connected}" />
        </Style>
        <Style Selector="Panel#Pulse.failing Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource Danger}" />
        </Style>
        <!-- Спокойное дыхание: ~1,6 с на вдох и столько же на выдох. Внизу гаснет полностью -
             тогда видно только бегущий хвост кольца, на пике горит весь круг -->
        <Style Selector="Panel#Pulse:not(.connecting)">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Подключение: пульс чаще - идёт работа -->
        <Style Selector="Panel#Pulse.connecting">
            <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="Infinite" PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.15" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Line.tick">
            <Setter Property="Stroke" Value="{DynamicResource LineStrong}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Внешний обод -->
        <Ellipse Width="252" Height="252" Stroke="{DynamicResource Line}" StrokeThickness="1" />

        <!-- Тиковая шкала -->
        <Canvas Width="288" Height="288">
            <Line Classes="tick" StartPoint="144,8" EndPoint="144,16" />
            <Line Classes="tick" StartPoint="280,144" EndPoint="272,144" />
            <Line Classes="tick" StartPoint="144,280" EndPoint="144,272" />
            <Line Classes="tick" StartPoint="8,144" EndPoint="16,144" />
            <Line Classes="tick" StartPoint="240.2,47.8" EndPoint="234.5,53.5" />
            <Line Classes="tick" StartPoint="240.2,240.2" EndPoint="234.5,234.5" />
            <Line Classes="tick" StartPoint="47.8,240.2" EndPoint="53.5,234.5" />
            <Line Classes="tick" StartPoint="47.8,47.8" EndPoint="53.5,53.5" />
        </Canvas>

        <!-- Свечение -->
        <Ellipse x:Name="Halo" Width="244" Height="244" StrokeThickness="14"
                 Classes.connected="{Binding IsConnected}"
                 Classes.connecting="{Binding IsConnecting}" />

        <!-- Дорожка: снаружи желобка -->
        <Ellipse Width="238" Height="238" Stroke="{DynamicResource LineStrong}" StrokeThickness="6" />

        <!-- Дуга состояния -->
        <Arc x:Name="StateArc" Width="238" Height="238" StrokeThickness="6" StrokeLineCap="Round"
             StartAngle="-90"
             Classes.connected="{Binding IsConnected}"
             Classes.connecting="{Binding IsConnecting}"
             Classes.failing="{Binding IsFailing}">
            <Arc.RenderTransform>
                <RotateTransform />
            </Arc.RenderTransform>
        </Arc>

        <!-- Дорожка и дуга - тоже трубка: неподвижный свет сверху, тень снизу -->
        <Ellipse Width="238" Height="238" StrokeThickness="6" Stroke="{DynamicResource RingShade}"
                 IsHitTestVisible="False" />

        <!-- ===== утопленный желобок вокруг кнопки =====
             Канал от края кнопки (r 93) до r 113 - 20 px, середина на диаметре 206.
             Глубину дают не цвета, а тени: свет сверху, поэтому верхняя стенка
             бросает тень на дно у внешнего края вверху, а внизу дно затеняет кнопка.
             Слои: дно → полоса → дыхание → тени стенок → кромки → кнопка -->
        <Ellipse Width="206" Height="206" StrokeThickness="20" Stroke="{DynamicResource GrooveBase}"
                 IsHitTestVisible="False" />

        <!-- Полоса по середине дна: вращается всегда, цвет и скорость - по состоянию.
             Тонкая, чтобы по бокам оставалось видно стенки канала -->
        <Panel x:Name="Sweep" Width="206" Height="206" IsHitTestVisible="False"
               Classes.connected="{Binding IsConnected}"
               Classes.connecting="{Binding IsConnecting}"
               Classes.failing="{Binding IsFailing}">
            <Panel.RenderTransform>
                <RotateTransform />
            </Panel.RenderTransform>
            <Ellipse x:Name="SweepGlow" StrokeThickness="9">
                <Ellipse.Effect>
                    <BlurEffect Radius="5" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="SweepRing" StrokeThickness="3" />
        </Panel>

        <!-- Дышащая обводка цвета состояния - по середине желобка (206 px).
             Три слоя: широкий мягкий ореол, плотное свечение и сама линия. На пике весь
             круг горит целиком, на спаде гаснет полностью. Лежит под кнопкой: внутренняя
             половина ореола скрыта, наружу идёт сияние.
             Панель шире кольца с запасом: размытие обрезается по границам элемента,
             и без запаса сияние не выходило бы наружу -->
        <Panel x:Name="Pulse" Width="274" Height="274" IsHitTestVisible="False"
               Classes.connected="{Binding IsConnected}"
               Classes.connecting="{Binding IsConnecting}"
               Classes.failing="{Binding IsFailing}">
            <!-- Внешнее сияние вокруг всего круга: именно оно делает «вдох» заметным -->
            <Panel Width="274" Height="274">
                <Ellipse Width="246" Height="246" StrokeThickness="22" Opacity="0.7">
                    <Ellipse.Effect>
                        <BlurEffect Radius="18" />
                    </Ellipse.Effect>
                </Ellipse>
            </Panel>
            <Panel Width="274" Height="274">
                <Ellipse Width="206" Height="206" StrokeThickness="26" Opacity="0.75">
                    <Ellipse.Effect>
                        <BlurEffect Radius="20" />
                    </Ellipse.Effect>
                </Ellipse>
            </Panel>
            <Panel Width="274" Height="274">
                <Ellipse Width="206" Height="206" StrokeThickness="9">
                    <Ellipse.Effect>
                        <BlurEffect Radius="6" />
                    </Ellipse.Effect>
                </Ellipse>
            </Panel>
            <Ellipse Width="206" Height="206" StrokeThickness="3" />
        </Panel>

        <!-- Тени стенок поверх полосы и свечения - благодаря им полоса уходит вглубь,
             а не лежит сверху. Свет неподвижный: тени не крутятся вместе с полосой.
             Размытые слои - в панелях с запасом, иначе размытие обрежется -->
        <Ellipse Width="206" Height="206" StrokeThickness="20" Stroke="{DynamicResource GrooveShade}"
                 IsHitTestVisible="False" />
        <!-- Тень от верхней (внешней) стенки - на дне у внешнего края, сильнее вверху -->
        <Panel Width="274" Height="274" IsHitTestVisible="False">
            <Ellipse Width="221" Height="221" StrokeThickness="9" Stroke="{DynamicResource GrooveWallTop}">
                <Ellipse.Effect>
                    <BlurEffect Radius="5" />
                </Ellipse.Effect>
            </Ellipse>
        </Panel>
        <!-- Тень от кнопки - на дне у внутреннего края, сильнее внизу -->
        <Panel Width="274" Height="274" IsHitTestVisible="False">
            <Ellipse Width="192" Height="192" StrokeThickness="9" Stroke="{DynamicResource GrooveWallBottom}">
                <Ellipse.Effect>
                    <BlurEffect Radius="5" />
                </Ellipse.Effect>
            </Ellipse>
        </Panel>
        <!-- Кромки канала: внешняя (r 113) и внутренняя у кнопки -->
        <Ellipse Width="227" Height="227" StrokeThickness="2" Stroke="{DynamicResource GrooveLip}"
                 IsHitTestVisible="False" />
        <Ellipse Width="187" Height="187" StrokeThickness="1.5" Stroke="{DynamicResource GrooveLip}"
                 IsHitTestVisible="False" />

        <!-- Кнопка в слое с 3D-поворотом: при наведении наклоняется вслед за курсором
             (см. ConnectDial.axaml.cs). Блик стекла наклоняется вместе с ней -->
        <Panel x:Name="Tilt" Width="184" Height="184">
            <Panel.RenderTransform>
                <Rotate3DTransform Depth="520" />
            </Panel.RenderTransform>

        <Button x:Name="Core" Width="184" Height="184" Click="OnCoreClick" HorizontalAlignment="Center"
                PointerMoved="OnCorePointerMoved" PointerExited="OnCorePointerExited"
                ToolTip.Tip="{Binding Active.Endpoint, FallbackValue=''}">
            <StackPanel Width="164">
                <!-- Значок страны: картинкой, потому что не каждая ОС рисует флаги-эмодзи -->
                <Border HorizontalAlignment="Center" CornerRadius="4" Padding="7,2" Margin="0,0,0,7"
                        Background="{DynamicResource SurfaceHover}"
                        IsVisible="{Binding Active.CountryCode, FallbackValue='', Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Width="16" Height="11" VerticalAlignment="Center"
                               Source="{Binding Active.CountryCode, FallbackValue='', Converter={StaticResource Flag}}" />
                        <TextBlock Classes="mono" Text="{Binding Active.CountryCode, FallbackValue=''}"
                                   FontSize="{StaticResource Size.Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="heading" Text="{Binding ActiveName}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Classes="mono" Text="{Binding Active.ProtocolLabel, FallbackValue='-'}"
                           HorizontalAlignment="Center" Margin="0,3,0,0"
                           FontSize="{StaticResource Size.Caption}" TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="Metric" Classes="mono" Text="{Binding Active.LatencyLabel, FallbackValue='-'}"
                           HorizontalAlignment="Center" Margin="0,5,0,0"
                           IsVisible="{Binding Active.HasLatency, FallbackValue=False}"
                           Classes.connected="{Binding IsConnected}"
                           Classes.failing="{Binding IsFailing}" />

                <Border Height="1" Background="{DynamicResource Line}" Margin="24,9,24,7" />

                <TextBlock x:Name="Action" Text="{Binding PrimaryActionLabel}" HorizontalAlignment="Center"
                           Classes.connected="{Binding IsConnected}" />
            </StackPanel>
        </Button>

            <!-- Блик выпуклого стекла сверху. Не перехватывает нажатия -->
            <Ellipse Width="150" Height="84" VerticalAlignment="Top" Margin="0,5,0,0"
                     Fill="{DynamicResource DialSheen}" IsHitTestVisible="False" />
        </Panel>
    </Panel>
</UserControl>
