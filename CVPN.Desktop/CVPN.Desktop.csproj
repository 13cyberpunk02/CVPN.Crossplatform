<Project Sdk="Microsoft.NET.Sdk">
  <!-- Точка входа для Windows и Linux. Платформенный код - в Platform/Windows и Platform/Linux. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\CVPN\Assets\cvpn.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CVPN\CVPN.csproj" />
    <ProjectReference Include="..\CVPN.Core\CVPN.Core.csproj" />
  </ItemGroup>
</Project>
